# Secret personnel Awin — ne jamais le préfixer par VITE_.
AWIN_ACCESS_TOKEN=

# Renseigné après la première exécution de `npm run awin:check`.
AWIN_PUBLISHER_ID=

# Identifiant public Google AdSense, au format ca-pub-1234567890123456.
VITE_ADSENSE_CLIENT_ID=

# Identifiants numériques des blocs d’annonces créés dans AdSense.
VITE_ADSENSE_SLOT_HOME_TOP=
VITE_ADSENSE_SLOT_HOME_INLINE=
VITE_ADSENSE_SLOT_DETAIL=

# URL publique sans slash final, utilisée pour les métadonnées et le sitemap.
VITE_PUBLIC_SITE_URL=

# Activer uniquement sur un hébergement servant les routes propres.
SEO_CLEAN_URLS=false

# Adresse publique recevant les signalements d’offres (facultatif).
VITE_REPORT_EMAIL=

# Informations publiques affichées dans les mentions légales.
# Ces valeurs seront intégrées au site publié : ne pas y mettre de secret.
VITE_LEGAL_PUBLISHER_NAME=
VITE_LEGAL_PUBLISHER_STATUS=
VITE_LEGAL_PUBLISHER_ADDRESS=
VITE_LEGAL_PUBLICATION_DIRECTOR=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_CONTACT_PHONE=
VITE_LEGAL_REGISTRATION_NUMBER=
VITE_LEGAL_VAT_NUMBER=
